{
  "name": "lolping",
  "productName": "lolPing",
  "version": "0.6.0",
  "private": true,
  "description": "League of Legends style ping wheel for your Windows, macOS and Linux desktop",
  "author": "Danrui Meng (https://github.com/darrenprx)",
  "license": "MIT",
  "homepage": "https://github.com/darrenprx/lolPing#readme",
  "repository": { "type": "git", "url": "https://github.com/darrenprx/lolPing.git" },
  "bugs": "https://github.com/darrenprx/lolPing/issues",
  "main": "out/main/bootstrap.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:helper": "node native/hook-helper/run.mjs build",
    "test:helper": "node native/hook-helper/run.mjs test",
    "dist": "npm run build:helper && electron-vite build && electron-builder --win --publish never",
    "dist:mac": "npm run build:helper && electron-vite build && electron-builder --mac --arm64 --publish never",
    "dev:site": "vite --config site/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts",
    "media": "npm run build:site && electron tools/capture-media/capture.mjs",
    "dist:linux": "npm run build:helper && electron-vite build && electron-builder --linux --publish never",
    "test:linux-input": "python3 native/hook-helper/tests/linux_x11_test.py"
  },
  "devDependencies": {
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.343",
    "@fluentui/react-motion-components-preview": "0.15.9",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/secp256k1": "3.2.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "dompurify": "3.4.17",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.10",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "fflate": "0.8.3",
    "jsdom": "29.1.1",
    "marked": "18.1.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  },
  "build": {
    "appId": "com.lolping.app",
    "productName": "lolPing",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["out/**/*", "package.json"],
    "extraResources": [
      { "from": "node_modules/pdfjs-dist/cmaps", "to": "pdfjs/cmaps" },
      { "from": "node_modules/pdfjs-dist/standard_fonts", "to": "pdfjs/standard_fonts" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "extraFiles": [{ "from": "tools/diagnostics", "to": ".", "filter": ["*.cmd", "*.ps1"] }],
      "extraResources": [
        { "from": "native/hook-helper/build/hook-helper.exe", "to": "hook-helper.exe" },
        { "from": "native/hook-helper/build/context-helper.exe", "to": "context-helper.exe" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "lolPing-Setup-${version}.exe",
      "include": "build/installer.nsh"
    },
    "mac": {
      "minimumSystemVersion": "13.0",
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        { "from": "native/hook-helper/build/hook-helper", "to": "hook-helper" },
        { "from": "native/hook-helper/build/context-helper", "to": "context-helper" },
        { "from": "build", "to": ".", "filter": ["tray*Template*.png"] }
      ],
      "extendInfo": {
        "NSAccessibilityUsageDescription": "lolPing reads the mouse and keyboard to open the ping wheel or the emote wheel when you hold its key and drag.",
        "NSDownloadsFolderUsageDescription": "lolPing saves update downloads to your Downloads folder.",
        "NSAppleEventsUsageDescription": "lolPing opens Terminal to continue an agent's session.",
        "NSScreenCaptureUsageDescription": "The teammate looks at your screen when you ask it to ping what it sees.",
        "NSLocalNetworkUsageDescription": "lolPing finds the other people in your room on the local network and sends them your pings."
      }
    },
    "dmg": { "artifactName": "lolPing-${version}-arm64.dmg" },
    "publish": [{ "provider": "github", "owner": "darrenprx", "repo": "lolPing" }],
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }, { "target": "deb", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "lolPing-${version}-${arch}.${ext}",
      "extraResources": [{ "from": "native/hook-helper/build/hook-helper", "to": "hook-helper" }],
      "desktop": { "entry": { "StartupWMClass": "lolping" } },
      "maintainer": "lolPing contributors",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libxtst6",
        "libxi6",
        "libx11-6",
        "libasound2",
        "libgbm1",
        "libnotify4",
        "libsecret-1-0",
        "libatspi2.0-0"
      ]
    }
  },
  "engines": { "node": ">=22.12.0" },
  "desktopName": "lolping.desktop"
}
